# Copy this file to .env and fill in your Oracle DB details

# Oracle username / password
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password

# Oracle DSN. Examples:
#   Local DB          -> localhost:1521/XEPDB1
#   Oracle Cloud (ADB) -> use the DSN string from your wallet / tnsnames.ora
ORACLE_DSN=localhost:1521/XEPDB1

# If you're using Oracle Autonomous DB with a wallet, set this to the wallet folder
# and uncomment the config_dir line in database.py
ORACLE_WALLET_DIR=

# Frontend origin allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
